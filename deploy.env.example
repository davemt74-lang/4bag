# FourBag deployment environment template
# Copy these values into your web-server / process environment.
# The application does not automatically parse this file.

FOURBAG_DB_DSN="mysql:host=127.0.0.1;dbname=fourbag;charset=utf8mb4"
FOURBAG_DB_USER="fourbag"
FOURBAG_DB_PASSWORD="replace-with-a-strong-password"

# Public HTTPS origin with no trailing slash.
FOURBAG_BASE_URL="https://fourbag.example.com"

# Stripe server-side credentials. Never expose these in browser JavaScript.
FOURBAG_STRIPE_SECRET_KEY="sk_live_replace_me"
FOURBAG_STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Transitional legacy league-operations key. Remove after all venue operators
# use account-based access.
FOURBAG_OPERATOR_KEY="replace-with-a-long-random-value"

# Keep disabled in production. When false, verified payment webhooks are the
# authority for marking FourBag board purchases paid.
FOURBAG_ALLOW_MANUAL_PAYMENT_COMPLETION="0"

# One-time administrator bootstrap values. Set only while running
# scripts/create-admin.php, then remove the password from the environment.
FOURBAG_BOOTSTRAP_EMAIL="admin@example.com"
FOURBAG_BOOTSTRAP_PASSWORD="replace-with-a-long-unique-password"
FOURBAG_BOOTSTRAP_NAME="FourBag Administrator"
